with "config/test_rp2040_config.gpr";
with "runtime_build.gpr";
with "ravenscar_build.gpr";

project Test_Rp2040 is

   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Test_Rp2040_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("test_rp2040.adb");

   package Compiler is
      for Default_Switches ("Ada") use Test_Rp2040_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Linker is
      for Switches ("Ada") use Runtime_Build.Linker_Switches & (
         "-Wl,-print-memory-usage",
         "-Wl,-gc-sections"
      );
   end Linker;

end Test_Rp2040;
